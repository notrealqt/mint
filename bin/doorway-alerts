#!/usr/bin/env bash
# Doorway rice — desktop alerts. Runs in the background (autostart).
#   CPU over 90°C for 30s · battery under 15% and not charging · internet down (gateway + 1.1.1.1)
# Each alert fires once, then again only after it has cleared.
set -u
hwmon() { for h in /sys/class/hwmon/hwmon*; do [ "$(cat "$h/name")" = "$1" ] && { echo "$h"; return; }; done; }
CPU=$(hwmon k10temp)/temp1_input
declare -A active=()
hot=0

alert() { # key urgency title body
  [ -n "${active[$1]:-}" ] && return
  active[$1]=1
  notify-send -a alerts -u "$2" -i dialog-warning "$3" "$4"
}
clear_() { unset "active[$1]"; }

while sleep 10; do
  t=$(( $(cat "$CPU") / 1000 ))
  if [ "$t" -ge 90 ]; then hot=$((hot + 10)); else hot=0; clear_ cpu; fi
  if [ $hot -ge 30 ]; then
    top=$(ps -eo comm,%cpu --sort=-%cpu --no-headers | head -1 | awk '{print $1" ("$2"%)"}')
    alert cpu critical "CPU running hot" "Tctl ${t}°C for ${hot}s · top: $top"
  fi

  cap=$(cat /sys/class/power_supply/BAT0/capacity); st=$(cat /sys/class/power_supply/BAT0/status)
  if [ "$cap" -lt 15 ] && [ "$st" = Discharging ]; then alert bat critical "Battery low" "${cap}% left · plug in soon"
  else clear_ bat; fi

  gw=$(ip route show default | awk '{print $3; exit}')
  if [ -n "$gw" ] && ! ping -n -c1 -W2 "$gw" >/dev/null 2>&1 && ! ping -n -c1 -W2 1.1.1.1 >/dev/null 2>&1; then
    alert net normal "Internet down" "gateway $gw and 1.1.1.1 not answering"
  else clear_ net; fi
done
