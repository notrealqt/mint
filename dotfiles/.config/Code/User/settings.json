{
    "security.workspace.trust.untrustedFiles": "open",
    "remote.SSH.remotePlatform": {
        "server": "linux",
        "gateway": "linux",
        "Kaggle": "linux",
        "vlphuong": "linux",
        "vlphuong1": "linux",
        "vtlphuong1": "linux",
        "vtlphuong2": "linux",
        "vtlphuong3": "linux",
        "vtlphuong": "linux",
        "vast4090": "linux"
    },
    "explorer.confirmDragAndDrop": false,
    "git.confirmSync": false,
    "chat.editing.confirmEditRequestRemoval": false,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmPasteNative": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "chat.viewSessions.orientation": "stacked",
    "workbench.secondarySideBar.defaultVisibility": "visible",
    "latex-workshop.latex.outDir": "%DIR%/build",
    "editor.rulers": [
        80,
        100
    ],
    "github.copilot.nextEditSuggestions.enabled": true,
    "git.autofetch": true,
    "files.exclude": {
        "**/.git": false
    },
    "diffEditor.maxComputationTime": 0,
    "workbench.startupEditor": "none",
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://arxiv.org/html/2409.16592v1": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://arxiv.org": {
            "approveRequest": true,
            "approveResponse": false
        }
    },
    "workbench.colorTheme": "Doorway",
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "right"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "latex": true
    },
    "git.enableSmartCommit": true,
    "oaicopilot.baseUrl": "https://api.deepseek.com/v1",
    "terminal.integrated.cursorStyle": "line",
    "claudeCode.hideOnboarding": true,
    "claudeCode.preferredLocation": "panel",
    "editor.fontFamily": "'GeistMono Nerd Font', 'GeistMono NF', monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.bracketPairColorization.enabled": true,
    "terminal.integrated.fontFamily": "'GeistMono Nerd Font'",
    "terminal.integrated.fontSize": 13,
    "window.titleBarStyle": "custom"
}