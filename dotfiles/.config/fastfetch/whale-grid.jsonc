{
  // Doorway rice — fastfetch beside the grid whale (whale-greet plays ~/.config/kitty/whale-grid.gif
  // over the blank 36x13 logo area). Info must fit in ~32 columns of a 70-column kitty.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file", "source": "~/.config/fastfetch/whale-grid-space.txt", "padding": { "top": 0, "left": 0, "right": 2 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "yellow", "output": "white" }
  },
  "modules": [
    "break",
    { "type": "title",    "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    "separator",
    { "type": "os",       "key": "󰣭 ", "format": "{name} {version-id}" },
    { "type": "kernel",   "key": " ", "format": "{release}" },
    { "type": "de",       "key": "󰧨 ", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": " " },
    { "type": "cpu",      "key": " ", "format": "{name}" },
    { "type": "memory",   "key": " ", "format": "{used} / {total}" },
    { "type": "uptime",   "key": "󰅐 " },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
