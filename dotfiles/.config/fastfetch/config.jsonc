{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "yellow", "output": "white" }
  },
  "modules": [
    "break",
    { "type": "os",       "key": "󰣭 " },
    { "type": "kernel",   "key": " " },
    { "type": "de",       "key": "󰧨 " },
    { "type": "wm",       "key": " " },
    { "type": "terminal", "key": " " },
    { "type": "shell",    "key": " " },
    { "type": "cpu",      "key": " " },
    { "type": "memory",   "key": " " },
    { "type": "uptime",   "key": "󰅐 " },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
